PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mobile_erp?schema=public"

# Telegram alerts (wave 3). Chat id is stored in store_settings; token stays here.
# Missing token or chat id → the bot no-ops (never blocks a sale).
TELEGRAM_BOT_TOKEN=""

# Auth — HS256 shift token (ADR 0005). No refresh token.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Browser origins allowed to call the API (comma-separated). Unset = Vite dev origins
# (localhost:5173) outside production, nothing in production (client is same-origin).
# CORS_ORIGINS="http://localhost:5173"

# First-admin bootstrap (pnpm bootstrap:admin). Only used when no users exist.
BOOTSTRAP_ADMIN_EMAIL="owner@malika.uz"
BOOTSTRAP_ADMIN_PASSWORD="change-me-strong-password"

# Dev-only seeded staff accounts (created once by an admin via POST /users; see README "Dev users").
SEED_CASHIER_EMAIL="cashier@malika.uz"
SEED_CASHIER_PASSWORD="change-me"
SEED_QC_EMAIL="qc@malika.uz"
SEED_QC_PASSWORD="change-me"

# Backups & restore (handoff 023, ADR 0051). Configured in the app (Settings →
# Backups); these are only fallbacks / infrastructure.
#
# Server-only state kept outside the database (master key, restore staging and
# recovery markers). The session cutoff lives in the database, not here.
# On Railway point this at a persistent volume, or set APP_MASTER_KEY instead.
DATA_DIR="./data"
# Overrides the DATA_DIR/master.key file: base64 or hex, exactly 32 bytes. Use
# this on Railway where the filesystem is ephemeral. Lose it and every secret
# (the backup passphrase, provider tokens) is unreadable.
# APP_MASTER_KEY=""
# Where encrypted backups (*.mbk) are written on the server (gitignored, never
# served over HTTP). Default ./backups
BACKUPS_DIR="./backups"
# Fallback backup passphrase. Prefer setting it in the app (stored encrypted);
# this env value is used only when no in-app passphrase is set. KEEP IT IN THE
# PASSWORD MANAGER — lose it and every backup is unrecoverable.
# BACKUP_PASSPHRASE=""
# Largest backup payload (dump + uploads) before encryption; a bigger payload is
# refused (BACKUP_TOO_LARGE). Default 32 GiB, well under the AES-GCM limit.
# BACKUP_MAX_PAYLOAD_BYTES="34359738368"
# Largest restore upload accepted. Default 2 GiB.
# BACKUP_MAX_UPLOAD_BYTES="2147483648"
# Optional: directory holding pg_dump / pg_restore if they are not on PATH.
# PG_BIN_DIR="/usr/lib/postgresql/17/bin"
#
# Storage places (ADR 0056). All configured in-app; these are env fallbacks.
# The server's own public origin, used for the OAuth callback address Google /
# Microsoft redirect back to. On Railway set it to the app URL; dev defaults to
# http://localhost:<PORT>.
# PUBLIC_URL="https://your-app.up.railway.app"
# Telegram bot token for backups (TELEGRAM_BOT_TOKEN is reused from above).
# Google Drive / OneDrive OAuth clients (set in-app, or here as a fallback):
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# MICROSOFT_OAUTH_CLIENT_ID=""
# MICROSOFT_OAUTH_CLIENT_SECRET=""
# Network timeouts for provider calls (ms) — a stalled remote fails fast instead
# of holding the backup lock. Defaults: request 30s, chunk 120s, whole place 30m.
# BACKUP_HTTP_TIMEOUT_MS="30000"
# BACKUP_CHUNK_TIMEOUT_MS="120000"
# BACKUP_PLACE_TIMEOUT_MS="1800000"
