// ---------------------------------------------------------------------------
// Store cash/card ledger (ADR 0024). Append-only and signed: every money
// movement is one row, a balance is the SUM of rows per account — never a
// stored number. 2a builds the ledger plus the owner's manual entries; 2b
// makes sales, returns, expenses, partner payments and purchases post rows
// automatically (adding the SALE/REFUND/... types and source-row links).
// ---------------------------------------------------------------------------

/// Where the store's money sits. Lookup (not an enum): CASH and CARD seeded;
/// more accounts are added as rows later.
model CashAccount {
  code      String  @id
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  transactions   CashTransaction[]
  shipments      Shipment[]
  recurrences    ExpenseRecurrence[]
  creditPayments CreditPayment[]
  repairPayments RepairPayment[]

  @@map("cash_accounts")
}

/// Why money moved. Lookup: OPENING, DEPOSIT, WITHDRAWAL, CORRECTION, TRANSFER
/// seeded in 2a. 2b adds SALE, REFUND, PARTNER_PAYMENT, PURCHASE, OVERHEAD,
/// EXPENSE. ADR 0026 adds DEVICE_EXPENSE (per-phone expense) and retires
/// OVERHEAD (isActive = false; kept only to label old history rows).
model CashTransactionType {
  code      String  @id
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  transactions CashTransaction[]

  @@map("cash_transaction_types")
}

/// One money movement. Append-only: no update or delete path — a mistake is
/// fixed by a new row. `amount` is signed: positive = money in, negative =
/// money out, never zero (enforced by a DB CHECK and the service). A transfer
/// writes two rows sharing `transferId` (one negative, one positive) so the
/// store total is unchanged. 2b posts rows automatically from the source event
/// and links back to it via exactly one of the nullable source ids below.
model CashTransaction {
  id                 String              @id @default(uuid())
  storeId            String
  store              Store               @relation(fields: [storeId], references: [id])
  accountCode        String
  account            CashAccount         @relation(fields: [accountCode], references: [code])
  typeCode           String
  type               CashTransactionType @relation(fields: [typeCode], references: [code])
  amount             Decimal             @db.Decimal(14, 2)
  occurredAt         DateTime            @default(now())
  note               String?
  /// Shared by the two rows of one transfer; null for every other row.
  transferId         String?
  /// At most one of these is set, tying the row to what moved the money (2b).
  saleId             String?
  sale               Sale?               @relation(fields: [saleId], references: [id])
  expenseId          String?
  expense            Expense?            @relation(fields: [expenseId], references: [id])
  partnerPaymentId   String?
  partnerPayment     PartnerPayment?     @relation(fields: [partnerPaymentId], references: [id])
  deviceId           String?
  device             Device?             @relation(fields: [deviceId], references: [id])
  shipmentId         String?
  shipment           Shipment?           @relation(fields: [shipmentId], references: [id])
  creditPaymentId    String?
  creditPayment      CreditPayment?      @relation(fields: [creditPaymentId], references: [id])
  /// The customer purchase this CUSTOMER_PURCHASE row paid for (ADR 0039); null
  /// otherwise. A trade-in purchase posts no row (its value netted the sale).
  customerPurchaseId String?
  customerPurchase   CustomerPurchase?   @relation(fields: [customerPurchaseId], references: [id])
  /// The shift a SHIFT_DIFFERENCE correction belongs to (ADR 0036); null otherwise.
  shiftId            String?
  shift              Shift?              @relation(fields: [shiftId], references: [id])
  /// The customer payment a REPAIR_PAYMENT row records (ADR 0040); null otherwise.
  repairPaymentId    String?
  repairPayment      RepairPayment?      @relation(fields: [repairPaymentId], references: [id])
  /// The ticket a REPAIR_OUTSIDE row (money out to an outside master) belongs to
  /// (ADR 0040); null otherwise.
  repairId           String?
  repair             Repair?             @relation(fields: [repairId], references: [id])
  /// The order a DELIVERY_FEE row belongs to (033); null otherwise.
  orderId            String?
  order              StorefrontOrder?    @relation(fields: [orderId], references: [id])
  createdById        String
  createdBy          User                @relation(fields: [createdById], references: [id])
  createdAt          DateTime            @default(now())

  @@index([storeId])
  @@index([accountCode])
  @@index([typeCode])
  @@index([occurredAt])
  @@index([transferId])
  @@index([saleId])
  @@index([expenseId])
  @@index([partnerPaymentId])
  @@index([deviceId])
  @@index([shipmentId])
  @@index([creditPaymentId])
  @@index([customerPurchaseId])
  @@index([shiftId])
  @@index([repairPaymentId])
  @@index([repairId])
  @@index([orderId])
  @@map("cash_transactions")
}
