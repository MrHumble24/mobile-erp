// ---------------------------------------------------------------------------
// Store settings & Telegram (PRD Module 6). Singleton row (id = 1).
// Bot token lives in env, not here.
// ---------------------------------------------------------------------------

model StoreSettings {
  id                  Int      @id @default(1)
  /// Free-text footer printed at the bottom of each receipt.
  receiptFooter       String?
  telegramChatId      String?
  /// Local shop closing time "HH:mm" for the daily digest.
  closingTime         String   @default("20:00")
  defaultWarrantyDays Int      @default(14)
  /// Nasiya (installment) defaults: due window and overdue reminder lead time.
  defaultNasiyaDueDays Int     @default(30)
  overdueReminderDays Int      @default(3)
  /// Alert when a sale's margin falls below this percent of landed cost.
  minMarginPercent    Decimal  @default(0) @db.Decimal(5, 2)
  /// Fallback low-stock threshold when no StockAlertRule matches.
  lowStockThreshold   Int      @default(2)
  /// Discounts (Change 12/7, ADR 0034). Off by default so a fresh shop sells at
  /// list price. `maxDiscountPercent` is the largest discount a cashier may give
  /// without the owner, as a percent of the list price. Presets are up to five
  /// suggested values per mode (percent values / fixed amounts).
  discountsEnabled       Boolean @default(false)
  discountPercentAllowed Boolean @default(true)
  discountAmountAllowed  Boolean @default(true)
  discountPresetsPercent Json    @default("[]") @db.JsonB
  discountPresetsAmount  Json    @default("[]") @db.JsonB
  maxDiscountPercent     Decimal @default(0) @db.Decimal(5, 2)
  /// Date the closing digest was last sent, so the minute-cron fires once a day.
  digestSentOn        DateTime? @db.Date
  updatedAt           DateTime @updatedAt

  @@map("store_settings")
}
