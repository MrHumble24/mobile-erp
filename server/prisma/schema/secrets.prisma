// ---------------------------------------------------------------------------
// Encrypted secrets store (handoff 023). One row per named secret, the value
// sealed with AES-256-GCM under the app master key (a file in DATA_DIR, never
// in this table). No route ever returns a value: the API only says "set".
// Reused by the backup passphrase and, later, provider OAuth tokens (handoff
// 024). Open-ended by design: `name` is a free string key, not a lookup.
// ---------------------------------------------------------------------------

model Secret {
  /// Stable key, e.g. `backup.passphrase`, `provider.google_drive.refresh_token`.
  name      String   @id
  /// iv(12) ++ authTag(16) ++ ciphertext, AES-256-GCM under the master key.
  sealed    Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("secrets")
}
