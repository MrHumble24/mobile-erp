// ---------------------------------------------------------------------------
// Operational expenses (PRD Module 5) — categories are user-managed data.
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses    Expense[]
  recurrences ExpenseRecurrence[]

  @@map("expense_categories")
}

model Expense {
  id           String             @id @default(uuid())
  storeId      String
  store        Store              @relation(fields: [storeId], references: [id])
  categoryId   String
  category     ExpenseCategory    @relation(fields: [categoryId], references: [id])
  amount       Decimal            @db.Decimal(14, 2)
  description  String?
  // Who was paid (booth landlord, utility provider, courier). Free text, not an entity.
  vendor       String?
  isRecurring  Boolean            @default(false)
  // Set when this row was spawned from a recurrence template; null for ad-hoc rows.
  recurrenceId String?
  recurrence   ExpenseRecurrence? @relation(fields: [recurrenceId], references: [id])
  incurredAt   DateTime           @default(now())
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id])
  // Soft delete: history stays for reports; all reads filter deletedAt IS NULL.
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([incurredAt])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([storeId])
  @@map("expenses")
}

// Recurring-expense template. A "generate due" action spawns real Expense rows
// for every active template whose nextDueAt has passed, then advances nextDueAt.
model ExpenseRecurrence {
  id          String          @id @default(uuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id])
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Decimal         @db.Decimal(14, 2)
  description String?
  vendor      String?
  // 'monthly' | 'weekly' — a fixed binary cadence, validated at the DTO.
  frequency   String
  nextDueAt   DateTime
  isActive    Boolean         @default(true)
  // Author id (no relation: adding a back-reference would touch the User model).
  createdById String
  expenses    Expense[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([nextDueAt])
  @@index([categoryId])
  @@index([storeId])
  @@map("expense_recurrences")
}
