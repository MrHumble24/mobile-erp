// ---------------------------------------------------------------------------
// B2C POS, customers, warranty, returns (PRD Module 3)
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?  @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@map("customers")
}

/// One sale event. Channel is derived: consignmentId null → retail, else B2B.
/// Net profit is derived: salePrice − landedCostSnapshot. A sale is either a
/// unit sale (deviceId set, modelId/quantity null) or a quantity sale (deviceId
/// null, modelId + quantity set) — never both or neither (CHECK
/// sales_unit_xor_quantity, ADR 0030). For a quantity sale `salePrice` is the
/// line total and `landedCostSnapshot` is quantity × average cost at sale time.
model Sale {
  id               String       @id @default(uuid())
  /// Idempotency key from the offline terminal's mutation queue.
  clientMutationId String?      @unique
  /// Where the sale happened. Not a duplicate of Device.storeId: once a unit can
  /// move between stores, this freezes where it was sold.
  storeId          String
  store            Store        @relation(fields: [storeId], references: [id])
  /// The unit sold (null for a quantity sale).
  deviceId         String?
  device           Device?      @relation(fields: [deviceId], references: [id])
  /// The QUANTITY product sold (null for a unit sale).
  modelId          String?
  model            DeviceModel? @relation(fields: [modelId], references: [id])
  /// Pieces sold (null for a unit sale; whole and positive for a quantity sale).
  quantity         Int?
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id])
  consignmentId    String?      @unique
  consignment      Consignment? @relation(fields: [consignmentId], references: [id])
  soldById         String
  soldBy           User         @relation(fields: [soldById], references: [id])

  salePrice          Decimal @db.Decimal(14, 2)
  /// Device.landedCost at sale time so later edits don't rewrite history.
  landedCostSnapshot Decimal @db.Decimal(14, 2)

  soldAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warranty         Warranty?
  return           SaleReturn?
  cashTransactions CashTransaction[]
  stockMovements   StockMovement[]

  @@index([soldAt])
  @@index([deviceId])
  @@index([modelId])
  @@index([storeId])
  @@map("sales")
}

model Warranty {
  saleId   String   @id
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  days     Int
  startsAt DateTime
  endsAt   DateTime

  @@index([endsAt])
  @@map("warranties")
}

model SaleReturn {
  saleId        String   @id
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  returnedAt    DateTime @default(now())
  reason        String?
  refundAmount  Decimal  @db.Decimal(14, 2)
  processedById String
  processedBy   User     @relation(fields: [processedById], references: [id])
  createdAt     DateTime @default(now())

  @@map("sale_returns")
}
