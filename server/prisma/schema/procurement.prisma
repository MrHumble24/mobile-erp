// ---------------------------------------------------------------------------
// Procurement (PRD Module 1)
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(uuid())
  name      String
  country   String?
  contact   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]

  @@map("suppliers")
}

/// One incoming batch. It has no expense of its own: each device carries its
/// own `unitExpense`, and the shipment's expense is their computed sum
/// (`unitExpenseTotal`, never stored). ADR 0026 (supersedes ADR 0006).
model Shipment {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  shipmentDate  DateTime
  expectedCount Int
  // Account the purchase + per-device expense money leaves from. Fixed at
  // creation (CASH default); every device intake and expense posts against it.
  paymentAccountCode String      @default("CASH")
  paymentAccount     CashAccount @relation(fields: [paymentAccountCode], references: [code])
  notes         String?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  devices          Device[]
  cashTransactions CashTransaction[]
  stockMovements   StockMovement[]

  @@index([shipmentDate])
  @@index([storeId])
  @@index([paymentAccountCode])
  @@map("shipments")
}
