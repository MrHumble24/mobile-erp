// ---------------------------------------------------------------------------
// Procurement (PRD Module 1)
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(uuid())
  name      String
  country   String?
  contact   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]

  @@map("suppliers")
}

/// One incoming batch. Overhead (shipping/customs) is spread evenly across
/// its devices to produce Device.landedCost.
model Shipment {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  shipmentDate  DateTime
  expectedCount Int
  overheadCost  Decimal  @default(0) @db.Decimal(14, 2)
  // Account the purchase + overhead money left from. Fixed at creation (CASH
  // default); every device intake and the overhead post against it.
  paymentAccountCode String      @default("CASH")
  paymentAccount     CashAccount @relation(fields: [paymentAccountCode], references: [code])
  notes         String?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  devices          Device[]
  cashTransactions CashTransaction[]

  @@index([shipmentDate])
  @@index([storeId])
  @@index([paymentAccountCode])
  @@map("shipments")
}
