<?xml version="1.0" encoding="utf-8"?>
<!--
  This is a LAN-first retail app: terminals talk to a dev/server box over plain
  HTTP (e.g. http://192.168.x.x:3000), and the dev panel lets the operator point
  at any LAN IP. Cleartext is therefore permitted. ponytail: a single permissive
  config; tighten to a per-host allow-list if the deployment ever adds HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
