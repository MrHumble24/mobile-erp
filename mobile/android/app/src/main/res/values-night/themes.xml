<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ink dark: window background / status-bar base before Compose mounts.
         Dark status bar means light icons, so windowLightStatusBar is false. -->
    <style name="Theme.MalikaErp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink_bg</item>
        <item name="android:statusBarColor">@color/ink_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
